# 이 파일을 복사해서 .env 파일로 만든 뒤 실제 값을 채워넣으세요.
# cp .env.example .env

# PostgreSQL
DB_USERNAME=myassistant
DB_PASSWORD=your_db_password_here
DB_R2DBC_URL=r2dbc:postgresql://localhost:5432/myassistant
DB_JDBC_URL=jdbc:postgresql://localhost:5432/myassistant

# OpenAI
OPENAI_API_KEY=sk-...

# JWT (base64 인코딩된 256비트 이상 키)
# 생성 명령: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_secret_here

# 소셜 로그인 (OAuth2) — 기본값이 없어 비워두면 앱이 시작되지 않음
# 소셜 로그인을 쓰지 않는다면 아무 값(예: unused)이나 넣어도 일반 로그인은 동작함
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (선택) 프런트엔드 주소 — 기본값: http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback
